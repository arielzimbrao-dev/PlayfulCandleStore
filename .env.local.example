# Shopify Storefront API — copie para .env.local e preencha
SHOPIFY_STORE_DOMAIN=playfulcandles.myshopify.com

# Token publico do Storefront API (canal Headless)
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=

# Token privado (delegate) — usado apenas no servidor, nunca exposto ao client.
# Se presente, tem prioridade sobre o publico nas chamadas server-side.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

# --- Site / SEO ---
NEXT_PUBLIC_SITE_URL=https://playfulcandles.com
NEXT_PUBLIC_GSC_VERIFICATION=      # token de verificação do Google Search Console (meta tag)

# --- Analytics & Tags (preencher quando existirem) ---
NEXT_PUBLIC_GTM_ID=                # GTM-XXXXXXX (Google Tag Manager — orquestrador recomendado)
NEXT_PUBLIC_GA_ID=                 # G-XXXXXXXXXX (GA4 direto, se não usares GTM)
NEXT_PUBLIC_GOOGLE_ADS_ID=         # AW-XXXXXXXXX (Google Ads — normalmente configurado dentro do GTM)

# --- Revalidação ISR (webhook Shopify) ---
SHOPIFY_REVALIDATE_SECRET=         # segredo partilhado; usar em /api/revalidate?secret=...
